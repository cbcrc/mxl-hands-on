# ============================================================
#  gst-apps on Kubernetes — environment configuration template
#
#  Copy this file to .env and fill in the values below.
#
#    cp k8s/gst-apps/.env.template k8s/gst-apps/.env
#
#  .env is git-ignored so the lab's addresses never end up in
#  this public repository. apply.sh substitutes these two
#  variables into the manifests before handing them to kubectl.
# ============================================================

# ------------------------------------------------------------
# MXL_LB_IP_APPS — MetalLB address shared by the eight app UIs
# ------------------------------------------------------------
# Every app Service carries metallb.universe.tf/allow-shared-ip
# and this address, so all eight UIs answer on one IP, each on
# its own compose port (9600-9606, 9699).
#
# Pick a free address in the MetalLB pool.
#
MXL_LB_IP_APPS=10.0.0.1

# ------------------------------------------------------------
# MXL_LB_IP_MEDIAMTX — MetalLB address held by MediaMTX alone
# ------------------------------------------------------------
# MediaMTX does NOT share an address: it needs
# externalTrafficPolicy: Local so WebRTC ICE sees the real
# client IP. It therefore takes a second address of its own.
#
# The browser talks to this address directly (WHIP/WHEP), so it
# must be reachable from wherever you open the app UIs.
#
MXL_LB_IP_MEDIAMTX=10.0.0.2

# ------------------------------------------------------------
# MXL_NODE — hostname of the node every pod is pinned to
# ------------------------------------------------------------
# The MXL domain is a tmpfs on one node's local disk, exposed as
# a hostPath PV. Everything that touches the domain must land on
# that same node, so each Deployment carries a nodeSelector and
# the PV carries a matching nodeAffinity.
#
# These two must always agree — if they disagree the pods hang
# in Pending with no obvious error.
#
# Must match a real `kubectl get nodes` name.
#
MXL_NODE=your-node-hostname
